body {
  font-family: Arial, sans-serif;
  margin: 0;
  line-height: 1.6;
  color: #222;
}

.hero {
  background: url('../images/hero.jpg') center/cover no-repeat;
  height: 80vh;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  color: white;
  position: relative;
}

.overlay {
  background: rgba(25, 5, 235, 0.795);
  padding: 40px;
  border-radius: 10px;
}

.hero h1 { font-size: 2.2rem; }
.hero p { font-size: 1.1rem; }

.hero-buttons { margin-top: 20px; }

.btn {
  display: inline-block;
  padding: 14px 20px;
  margin: 5px;
  border-radius: 6px;
  text-decoration: none;
  font-weight: bold;
}

.primary { background: #28a745; color: white; }
.secondary { background: #007bff; color: white; }

.section {
  padding: 60px 20px;
  text-align: center;
}

.dark {
  background: #f4f4f4;
}

.grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 20px;
  margin-top: 20px;
}

.card {
  padding: 20px;
  border: 1px solid #ddd;
  border-radius: 10px;
  background: white;
}

.reviews .review {
  padding: 15px;
  margin: 10px;
  background: white;
  border-radius: 10px;
}

.cta {
  background: #111;
    color: white;
}

.sticky-cta {
  position: fixed;
  bottom: 0;
  width: 100%;
  display: flex;
  justify-content: space-around;
  background: #111;
  padding: 10px;
}

.sticky-cta a {
  color: white;
  text-decoration: none;
  font-weight: bold;
}

img {
  width: 100%;
  border-radius: 10px;
}

footer {
  background: #111;
  color: white;
  text-align: center;
  padding: 20px;
}
